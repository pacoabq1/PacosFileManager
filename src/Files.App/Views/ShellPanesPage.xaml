<Page
	x:Class="Files.App.Views.ShellPanesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///Styles/DefaultGridSplitterStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource DefaultGridSplitterStyle}" TargetType="controls:GridSplitter">
				<Setter Target="Width" Value="4" />
				<Setter Target="Background" Value="Transparent" />
				<Setter Target="Opacity" Value="0" />
				<Setter Target="ResizeBehavior" Value="BasedOnAlignment" />
				<Setter Target="HorizontalAlignment" Value="Stretch" />
				<Setter Target="VerticalAlignment" Value="Stretch" />
			</Style>
		</ResourceDictionary>
	</Page.Resources>

	<Grid RowDefinitions="Auto,*">
		<StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
			<ToggleButton
				x:Uid="/PacosFileManager/RemoteToggle"
				Click="RemoteToggle_Click" />
			<HyperlinkButton
				x:Uid="/PacosFileManager/WebsiteLink"
				NavigateUri="https://pacosworld.com/" />
		</StackPanel>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
			<Grid>
				<!--  TabFocusNavigation is set to 'once' to prevent focus from auto switching to the next pane  -->
				<Grid x:Name="RootGrid" TabFocusNavigation="Once" />

				<Border
					x:Name="TabDropOverlay"
					AllowDrop="True"
					Background="Transparent"
					DragLeave="TabDropOverlay_DragLeave"
					DragOver="TabDropOverlay_DragOver"
					Drop="TabDropOverlay_Drop"
					Visibility="Collapsed" />
			</Grid>

			<ScrollViewer
				x:Name="RemotePane"
				Grid.Column="1"
				Width="280"
				Visibility="Collapsed">
				<StackPanel Padding="16" Spacing="10">
					<TextBlock
						x:Uid="/PacosFileManager/RemoteHeading"
						Style="{StaticResource SubtitleTextBlockStyle}" />
					<ComboBox
						x:Uid="/PacosFileManager/Protocol"
						HorizontalAlignment="Stretch"
						SelectedIndex="0">
						<ComboBoxItem Content="SFTP" />
						<ComboBoxItem x:Uid="/PacosFileManager/ExplicitFtps" />
						<ComboBoxItem x:Uid="/PacosFileManager/ImplicitFtps" />
						<ComboBoxItem Content="FTP" />
					</ComboBox>
					<TextBox x:Uid="/PacosFileManager/Host" />
					<TextBox x:Uid="/PacosFileManager/Port" InputScope="Number" />
					<TextBox x:Uid="/PacosFileManager/Username" />
					<TextBlock x:Uid="/PacosFileManager/PrototypeStatus" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Page>
