<Page
	x:Class="Files.App.Views.ShellPanesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="ms-appx:///Styles/DefaultGridSplitterStyle.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<Style BasedOn="{StaticResource DefaultGridSplitterStyle}" TargetType="controls:GridSplitter">
				<Setter Target="Width" Value="4" />
				<Setter Target="Background" Value="Transparent" />
				<Setter Target="Opacity" Value="0" />
				<Setter Target="ResizeBehavior" Value="BasedOnAlignment" />
				<Setter Target="HorizontalAlignment" Value="Stretch" />
				<Setter Target="VerticalAlignment" Value="Stretch" />
			</Style>
		</ResourceDictionary>
	</Page.Resources>

	<Grid RowDefinitions="Auto,*">
		<StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
			<ToggleButton
				x:Uid="/PacosFileManager/RemoteToggle"
				Click="RemoteToggle_Click" />
			<HyperlinkButton
				x:Uid="/PacosFileManager/WebsiteLink"
				NavigateUri="https://pacosworld.com/" />
		</StackPanel>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
			<Grid>
				<!--  TabFocusNavigation is set to 'once' to prevent focus from auto switching to the next pane  -->
				<Grid x:Name="RootGrid" TabFocusNavigation="Once" />

				<Border
					x:Name="TabDropOverlay"
					AllowDrop="True"
					Background="Transparent"
					DragLeave="TabDropOverlay_DragLeave"
					DragOver="TabDropOverlay_DragOver"
					Drop="TabDropOverlay_Drop"
					Visibility="Collapsed" />
			</Grid>

			<ScrollViewer
				x:Name="RemotePane"
				Grid.Column="1"
				Width="280"
				Visibility="Collapsed">
				<StackPanel Padding="16" Spacing="10">
					<TextBlock
						x:Uid="/PacosFileManager/RemoteHeading"
						Style="{StaticResource SubtitleTextBlockStyle}" />
					<StackPanel x:Name="RemoteSettings" Spacing="8">
						<ListView x:Name="SavedFtpSites" MaxHeight="180">
							<ListView.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
										<Button Content="Quick connect" Tag="{Binding}" Click="QuickFtpConnect_Click" />
									</StackPanel>
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Button Content="Edit site" Click="EditFtpSite_Click" />
							<Button Content="Delete site" Click="DeleteFtpSite_Click" />
						</StackPanel>
						<Button Content="Import FileZilla sites" Click="ImportFileZillaSites_Click" />
						<TextBox x:Name="FtpSiteName" Header="Site name" />
						<TextBox x:Name="FtpStartPath" Header="Saved folder" Text="/" />
						<Button Content="Save site" Click="SaveFtpSite_Click" />
						<Button Content="Save active FTP folder" Click="SaveFtpPath_Click" />
						<Button Content="Sync both panes" Click="SyncFtpPanes_Click" />
						<ComboBox x:Name="RemoteProtocol" Header="Protocol" SelectedIndex="1" HorizontalAlignment="Stretch">
							<ComboBoxItem Content="SFTP" IsEnabled="False" />
							<ComboBoxItem Content="Explicit FTPS" />
							<ComboBoxItem Content="Implicit FTPS" />
							<ComboBoxItem Content="FTP" />
						</ComboBox>
						<TextBox x:Name="RemoteHost" Header="Host" />
						<TextBox x:Name="RemotePort" Header="Port (optional)" InputScope="Number" />
						<TextBox x:Name="RemoteUser" Header="Username" />
						<PasswordBox x:Name="RemotePassword" Header="Password" />
					</StackPanel>
					<TextBlock x:Name="RemoteConnectionStatus" Text="Disconnected" FontWeight="SemiBold" />
					<Button x:Name="RemoteConnect" Content="Connect" Click="RemoteConnect_Click" />
					<StackPanel x:Name="RemoteBrowser" Visibility="Collapsed" Spacing="8">
						<TextBox x:Name="RemoteDirectory" Header="Remote folder" Text="/" />
						<Button Content="List folder" Click="RemoteList_Click" />
						<ListView x:Name="RemoteEntries" MaxHeight="240" DisplayMemberPath="Name" />
						<Button Content="Open selected folder" Click="RemoteOpen_Click" />
						<Button Content="Upload file…" Click="RemoteUpload_Click" />
						<Button Content="Download to active pane" Click="RemoteDownload_Click" />
					</StackPanel>
					<Button x:Name="RemoteCancel" Content="Cancel" IsEnabled="False" Click="RemoteCancel_Click" />
					<TextBlock x:Name="RemoteTransferDetails" TextWrapping="Wrap" Visibility="Collapsed" />
					<ProgressBar x:Name="RemoteProgress" Visibility="Collapsed" />
					<TextBlock x:Name="RemoteStatus" TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Page>
